# Environment
NODE_ENV=development

# Server Configuration
PORT=3004

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM="Equipment Rental Platform <your-email@gmail.com>"
EMAIL_VERIFICATION_URL=http://localhost:3100
EMAIL_PASSWORD_RESET_URL=http://localhost:3100

# RabbitMQ Configuration
RABBITMQ_URL=amqp://admin:your-rabbitmq-password@rabbitmq:5672
RABBITMQ_USER=admin
RABBITMQ_PASS=your-rabbitmq-password
RABBITMQ_EXCHANGE=rental-app.events

# Application Configuration
APP_NAME=Notification Service
APP_VERSION=1.0.0

# Email Retry Configuration
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY=5000
EMAIL_SEND_TIMEOUT=30000
