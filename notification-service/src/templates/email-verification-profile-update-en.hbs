<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your New Email Address</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, 'Segoe UI', Roboto, sans-serif;
            background-color: #f8fafc;
            line-height: 1.6;
        }
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
        }
        .header {
            background-color: #1e40af;
            padding: 30px 20px;
            text-align: left;
        }
        .header-title {
            color: #ffffff;
            font-size: 20px;
            font-weight: bold;
            margin: 0;
        }
        .content {
            padding: 40px 20px;
        }
        .greeting {
            font-size: 24px;
            color: #0f172a;
            margin: 0 0 20px 0;
            font-weight: bold;
        }
        .paragraph {
            font-size: 14px;
            color: #0f172a;
            margin: 16px 0;
        }
        .button-container {
            text-align: center;
            margin: 30px 0;
        }
        .verify-button {
            display: inline-block;
            background-color: #1e40af;
            color: #ffffff;
            text-decoration: none;
            padding: 14px 32px;
            border-radius: 6px;
            font-size: 16px;
            font-weight: bold;
            min-height: 44px;
            line-height: 1.3;
        }
        .verify-button:hover {
            background-color: #1e3a8a;
        }
        .info-card {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
        }
        .info-title {
            font-size: 16px;
            color: #1e40af;
            font-weight: bold;
            margin: 0 0 12px 0;
        }
        .warning-card {
            background-color: #fef3c7;
            border: 1px solid #fbbf24;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
        }
        .warning-title {
            font-size: 16px;
            color: #92400e;
            font-weight: bold;
            margin: 0 0 12px 0;
        }
        .email-detail {
            font-family: 'Courier New', monospace;
            background-color: #f1f5f9;
            padding: 8px 12px;
            border-radius: 4px;
            display: inline-block;
            color: #1e40af;
            font-weight: bold;
        }
        .footer {
            background-color: #f8fafc;
            padding: 30px 20px;
            text-align: center;
        }
        .footer-text {
            font-size: 12px;
            color: #64748b;
            margin: 8px 0;
        }
        .footer-link {
            color: #1e40af;
            text-decoration: none;
        }
        .divider {
            height: 1px;
            background-color: #e2e8f0;
            margin: 30px 0;
        }
        @media only screen and (max-width: 480px) {
            .content {
                padding: 30px 15px;
            }
            .greeting {
                font-size: 20px;
            }
            .verify-button {
                padding: 12px 24px;
                font-size: 14px;
            }
        }
    </style>
</head>
<body>
    <table role="presentation" class="email-container" cellpadding="0" cellspacing="0">
        <tr>
            <td class="header">
                <h1 class="header-title">Equipment Rental Platform</h1>
            </td>
        </tr>
        <tr>
            <td class="content">
                <h2 class="greeting">Hello, {{fullName}}! 👋</h2>
                
                <p class="paragraph">
                    Your email address has been changed by your company administrator.
                </p>
                
                <div class="info-card">
                    <h3 class="info-title">Email Change Details</h3>
                    <p class="paragraph" style="margin: 8px 0;">
                        <strong>Previous email:</strong> <span class="email-detail">{{oldEmail}}</span>
                    </p>
                    <p class="paragraph" style="margin: 8px 0;">
                        <strong>New email:</strong> <span class="email-detail">{{newEmail}}</span>
                    </p>
                </div>
                
                <p class="paragraph">
                    To continue using your account with this new email address, please verify it by clicking the button below:
                </p>
                
                <div class="button-container">
                    <a href="{{verificationUrl}}" class="verify-button">Verify New Email Address</a>
                </div>
                
                <div class="warning-card">
                    <h3 class="warning-title">⚠️ Important Information</h3>
                    <p class="paragraph" style="margin: 8px 0; color: #92400e;">
                        <strong>Your account remains active</strong> during the verification process. You can continue to use the platform normally.
                    </p>
                    <p class="paragraph" style="margin: 8px 0; color: #92400e;">
                        If you did not request this email change or believe it was made in error, please contact your company administrator or our support team immediately.
                    </p>
                </div>
                
                <div class="divider"></div>
                
                <p class="paragraph" style="font-size: 12px; color: #64748b;">
                    <strong>Note:</strong> This verification link will expire in 24 hours. 
                    If you need a new verification link, please contact your company administrator.
                </p>
                
                <p class="paragraph" style="font-size: 12px; color: #64748b;">
                    If the button doesn't work, copy and paste this link into your browser:<br>
                    <span style="word-break: break-all; color: #1e40af;">{{verificationUrl}}</span>
                </p>
            </td>
        </tr>
        <tr>
            <td class="footer">
                <p class="footer-text">
                    © {{currentYear}} Equipment Rental Platform. All rights reserved.
                </p>
                <p class="footer-text">
                    Questions? Contact us at 
                    <a href="mailto:samaninsystems@gmail.com" class="footer-link">samaninsystems@gmail.com</a>
                </p>
                <p class="footer-text">
                    <a href="#" class="footer-link">Privacy Policy</a> | 
                    <a href="#" class="footer-link">Terms of Service</a>
                </p>
            </td>
        </tr>
    </table>
</body>
</html>
