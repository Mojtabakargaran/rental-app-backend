# Environment
NODE_ENV=development

# Server Configuration
PORT=3001
GRPC_PORT=50051

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=auth_db
DB_USERNAME=postgres
DB_PASSWORD=your-database-password
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-and-random
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Bcrypt Configuration
BCRYPT_ROUNDS=12

# Verification Token Configuration
VERIFICATION_TOKEN_EXPIRATION_HOURS=24

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_URL=amqp://admin:your-rabbitmq-password@rabbitmq:5672
RABBITMQ_USER=admin
RABBITMQ_PASS=your-rabbitmq-password
RABBITMQ_EXCHANGE=rental-app.events

# gRPC Service URLs
USER_SERVICE_URL=rental-user-service:50052
TENANT_SERVICE_URL=rental-tenant-service:50053

# Application Configuration
APP_NAME=Auth Service
APP_VERSION=1.0.0
